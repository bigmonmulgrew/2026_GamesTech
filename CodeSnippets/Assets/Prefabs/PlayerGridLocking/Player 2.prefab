--- !u!114 &3075465575919983036
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4872285670777711583}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7216a00caa02f044bb9d6cafa8f8cb6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Readme
  text: "This scene has more than one player. \n\nOnly enable 1 at a time.\n\nThis
    one has a script \"SideStepCollider\". \n\nThe player collider has been adjusted
    to (0.98,0.98), slightly smaller than the image. This means we don't generate
    collisions when the player moves next to the obstacle but isn't moving towards
    it.\n\nThis projects its collider to test for obstacles and when found it moves
    perpendicular to the collider using the shortest route.\n\nWhen there are no
    obstacles it locks to the grid similar to the Player 1 example"
